{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "a1_mediator": {
      "type": "object",
      "required": ["service_port", "policy_types"],
      "properties": {
        "service_port": {
          "type": "number",
          "minimum": 1024,
          "maximum": 65535
        },
        "policy_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "QoS_OPTIMIZATION", 
              "LOAD_BALANCING", 
              "ENERGY_SAVING"
            ]
          }
        }
      }
    }
  }
}