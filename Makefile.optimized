# Optimized Makefile for O-RAN Near-RT RIC
# Performance-focused build system with parallel execution support

# Build variables
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
MAKEFLAGS += --warn-undefined-variables --no-builtin-rules

# Version and build info
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_TIME := $(shell date -u '+%Y-%m-%d_%H:%M:%S')
GIT_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")

# Go parameters
GO := go
GOFLAGS := -v
LDFLAGS := -ldflags "-X main.Version=$(VERSION) -X main.BuildTime=$(BUILD_TIME) -X main.GitCommit=$(GIT_COMMIT) -s -w"
CGO_ENABLED ?= 1

# Directories
BIN_DIR := bin
BUILD_DIR := build
COVERAGE_DIR := coverage
DIST_DIR := dist

# Binary names
BINARIES := dashboard-api ric xapp-hello-world

# Docker settings
DOCKER_REGISTRY ?= localhost:5000
DOCKER_NAMESPACE ?= oran
DOCKER_TAG ?= $(VERSION)

# Parallel jobs
PARALLEL_JOBS ?= $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

.PHONY: all
all: clean build test lint ## Build everything and run tests

.PHONY: help
help: ## Display this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

# ============================================================================
# Build targets
# ============================================================================

.PHONY: build
build: $(BINARIES) ## Build all binaries

$(BINARIES): setup-dirs
	@echo "Building $@..."
	$(GO) build $(GOFLAGS) $(LDFLAGS) -o $(BIN_DIR)/$@ ./cmd/$@

.PHONY: build-parallel
build-parallel: setup-dirs ## Build all binaries in parallel
	@echo "Building binaries in parallel ($(PARALLEL_JOBS) jobs)..."
	@$(MAKE) -j$(PARALLEL_JOBS) $(BINARIES)

.PHONY: build-linux
build-linux: setup-dirs ## Cross-compile for Linux
	@echo "Cross-compiling for Linux..."
	GOOS=linux GOARCH=amd64 $(MAKE) build

# ============================================================================
# Testing targets
# ============================================================================

.PHONY: test
test: setup-dirs ## Run tests
	@echo "Running tests..."
	$(GO) test -race -coverprofile=$(COVERAGE_DIR)/coverage.out ./...

.PHONY: test-short
test-short: ## Run short tests
	$(GO) test -short -race ./...

.PHONY: test-integration
test-integration: ## Run integration tests
	$(GO) test -race -tags=integration ./tests/integration/...

.PHONY: test-coverage
test-coverage: test ## Generate coverage report
	@echo "Generating coverage report..."
	@$(GO) tool cover -html=$(COVERAGE_DIR)/coverage.out -o $(COVERAGE_DIR)/coverage.html
	@$(GO) tool cover -func=$(COVERAGE_DIR)/coverage.out | grep total: | awk '{print "Total coverage: " $$3}'

.PHONY: test-benchmark
test-benchmark: ## Run benchmarks
	$(GO) test -bench=. -benchmem -run=^$$ ./...

# ============================================================================
# Code quality targets
# ============================================================================

.PHONY: lint
lint: ## Run linters
	@echo "Running linters..."
	@if command -v golangci-lint &> /dev/null; then \
		golangci-lint run --timeout=5m; \
	else \
		echo "golangci-lint not installed. Install with: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"; \
	fi

.PHONY: fmt
fmt: ## Format code
	@echo "Formatting code..."
	$(GO) fmt ./...
	@if command -v goimports &> /dev/null; then \
		goimports -w -local github.com/oran $$(find . -name "*.go" -not -path "./vendor/*"); \
	fi

.PHONY: vet
vet: ## Run go vet
	$(GO) vet ./...

.PHONY: security
security: ## Run security scan
	@if command -v gosec &> /dev/null; then \
		gosec -fmt json -out $(COVERAGE_DIR)/security.json ./...; \
	else \
		echo "gosec not installed. Install with: go install github.com/securego/gosec/v2/cmd/gosec@latest"; \
	fi

# ============================================================================
# Docker targets
# ============================================================================

.PHONY: docker-build
docker-build: ## Build all Docker images
	@for binary in $(BINARIES); do \
		echo "Building Docker image for $$binary..."; \
		docker build \
			--build-arg VERSION=$(VERSION) \
			--build-arg BUILD_TIME=$(BUILD_TIME) \
			--build-arg GIT_COMMIT=$(GIT_COMMIT) \
			-f $(BUILD_DIR)/$$binary/Dockerfile \
			-t $(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG) \
			-t $(DOCKER_NAMESPACE)/$$binary:latest .; \
	done

.PHONY: docker-push
docker-push: ## Push Docker images to registry
	@for binary in $(BINARIES); do \
		echo "Pushing $$binary to $(DOCKER_REGISTRY)..."; \
		docker tag $(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG) \
			$(DOCKER_REGISTRY)/$(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG); \
		docker push $(DOCKER_REGISTRY)/$(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG); \
	done

.PHONY: docker-build-multi-arch
docker-build-multi-arch: ## Build multi-architecture Docker images
	@for binary in $(BINARIES); do \
		echo "Building multi-arch image for $$binary..."; \
		docker buildx build \
			--platform linux/amd64,linux/arm64 \
			--build-arg VERSION=$(VERSION) \
			-f $(BUILD_DIR)/$$binary/Dockerfile \
			-t $(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG) \
			--push .; \
	done

# ============================================================================
# Helm targets
# ============================================================================

.PHONY: helm-lint
helm-lint: ## Lint all Helm charts
	@for chart in helm/*/; do \
		if [ -f "$$chart/Chart.yaml" ]; then \
			echo "Linting $$chart..."; \
			helm lint $$chart; \
		fi \
	done

.PHONY: helm-package
helm-package: setup-dirs ## Package Helm charts
	@mkdir -p $(DIST_DIR)/charts
	@for chart in helm/*/; do \
		if [ -f "$$chart/Chart.yaml" ]; then \
			echo "Packaging $$chart..."; \
			helm package $$chart -d $(DIST_DIR)/charts; \
		fi \
	done

.PHONY: helm-test
helm-test: ## Test Helm charts
	@for chart in helm/*/; do \
		if [ -f "$$chart/Chart.yaml" ]; then \
			helm unittest $$chart || echo "helm-unittest not installed"; \
		fi \
	done

# ============================================================================
# Development targets
# ============================================================================

.PHONY: dev
dev: ## Run development server with hot reload
	@echo "Starting development environment..."
	@command -v air &> /dev/null || go install github.com/cosmtrek/air@latest
	air -c .air.toml

.PHONY: proto
proto: ## Generate protobuf files
	@echo "Generating protobuf files..."
	@if [ -f scripts/generate-proto.sh ]; then \
		bash scripts/generate-proto.sh; \
	else \
		echo "Proto generation script not found"; \
	fi

.PHONY: mock
mock: ## Generate mocks
	@echo "Generating mocks..."
	@command -v mockgen &> /dev/null || go install github.com/golang/mock/mockgen@latest
	go generate ./...

.PHONY: deps
deps: ## Download and verify dependencies
	$(GO) mod download
	$(GO) mod verify

.PHONY: deps-update
deps-update: ## Update dependencies
	$(GO) get -u ./...
	$(GO) mod tidy

.PHONY: deps-graph
deps-graph: ## Show dependency graph
	@command -v godepgraph &> /dev/null || go install github.com/kisielk/godepgraph@latest
	godepgraph -s -only github.com/oran/near-rt-ric-new ./... | dot -Tpng -o $(COVERAGE_DIR)/deps.png

# ============================================================================
# Deployment targets
# ============================================================================

.PHONY: deploy-local
deploy-local: docker-build ## Deploy to local Kubernetes
	@echo "Deploying to local Kubernetes..."
	kubectl create namespace oran --dry-run=client -o yaml | kubectl apply -f -
	helm upgrade --install near-rt-ric ./helm/near-rt-ric \
		--namespace oran \
		--set image.tag=$(DOCKER_TAG) \
		--wait

.PHONY: deploy-dev
deploy-dev: ## Deploy to development environment
	@echo "Deploying to development..."
	./scripts/deploy-dev.sh

.PHONY: deploy-staging
deploy-staging: ## Deploy to staging environment
	@echo "Deploying to staging..."
	./scripts/deploy-staging.sh

# ============================================================================
# Cleanup targets
# ============================================================================

.PHONY: clean
clean: ## Clean build artifacts
	@echo "Cleaning build artifacts..."
	rm -rf $(BIN_DIR) $(COVERAGE_DIR) $(DIST_DIR)
	rm -f *.exe *.out coverage coverage.* *.test
	$(GO) clean -cache -testcache -modcache

.PHONY: clean-docker
clean-docker: ## Clean Docker images
	@echo "Cleaning Docker images..."
	@for binary in $(BINARIES); do \
		docker rmi -f $(DOCKER_NAMESPACE)/$$binary:$(DOCKER_TAG) 2>/dev/null || true; \
		docker rmi -f $(DOCKER_NAMESPACE)/$$binary:latest 2>/dev/null || true; \
	done

.PHONY: clean-all
clean-all: clean clean-docker ## Clean everything
	@echo "Cleaning everything..."
	rm -rf ui/node_modules ui/build
	docker system prune -f

# ============================================================================
# Utility targets
# ============================================================================

.PHONY: setup-dirs
setup-dirs: ## Create necessary directories
	@mkdir -p $(BIN_DIR) $(COVERAGE_DIR) $(DIST_DIR)

.PHONY: info
info: ## Show build information
	@echo "Version: $(VERSION)"
	@echo "Build Time: $(BUILD_TIME)"
	@echo "Git Commit: $(GIT_COMMIT)"
	@echo "Go Version: $(shell $(GO) version)"
	@echo "Platform: $(shell uname -s)/$(shell uname -m)"
	@echo "Parallel Jobs: $(PARALLEL_JOBS)"

.PHONY: install-tools
install-tools: ## Install development tools
	@echo "Installing development tools..."
	go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
	go install github.com/securego/gosec/v2/cmd/gosec@latest
	go install github.com/cosmtrek/air@latest
	go install github.com/golang/mock/mockgen@latest
	go install github.com/kisielk/godepgraph@latest
	go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
	go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

.PHONY: pre-commit
pre-commit: fmt lint test-short ## Run pre-commit checks

# Default target
.DEFAULT_GOAL := help